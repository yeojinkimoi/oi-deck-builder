{
  "canvas": { "w": 11.4, "h": 5.2 },
  "defaults": { "fontFace": "Lucida Sans", "fontSize": 13, "color": "DARK_TEXT", "lineColor": "LINE_GRAY", "lineWidth": 1 },
  "shapes": [
    { "type": "text", "x": 0, "y": 0.15, "w": 11.4, "h": 0.45, "bold": true, "fontSize": 15,
      "text": "Each new tree is trained on the mistakes (residuals) of the trees before it" },

    { "type": "ellipse", "x": 0.15, "y": 2.0, "w": 1.7, "h": 1.0, "text": "Training data\n(x, y)", "fill": "FFFFFF", "line": { "color": "NAVY", "width": 1 }, "fontSize": 12, "bold": true },

    { "type": "arrow", "x1": 1.9, "y1": 2.5, "x2": 2.9, "y2": 2.5 },
    { "type": "rect", "rounded": true, "x": 2.9, "y": 1.95, "w": 1.9, "h": 1.1, "text": "Tree 1\nf₁(x)", "fill": "OI_GREEN", "color": "FFFFFF", "bold": true, "line": null },
    { "type": "text", "x": 2.7, "y": 3.2, "w": 2.3, "h": 0.35, "fontSize": 11, "color": "SUBTITLE_GRAY", "text": "fits the outcome y" },

    { "type": "arrow", "x1": 4.85, "y1": 2.5, "x2": 6.05, "y2": 2.5, "label": "r₁ = y − f₁(x)", "labelDy": -0.32, "labelSize": 11, "labelW": 1.8 },
    { "type": "rect", "rounded": true, "x": 6.05, "y": 1.95, "w": 1.9, "h": 1.1, "text": "Tree 2\nf₂(x)", "fill": "OI_GREEN", "color": "FFFFFF", "bold": true, "line": null },
    { "type": "text", "x": 5.85, "y": 3.2, "w": 2.3, "h": 0.35, "fontSize": 11, "color": "SUBTITLE_GRAY", "text": "fits residuals r₁" },

    { "type": "arrow", "x1": 8.0, "y1": 2.5, "x2": 9.2, "y2": 2.5, "label": "r₂", "labelDy": -0.32, "labelSize": 11 },
    { "type": "rect", "rounded": true, "x": 9.2, "y": 1.95, "w": 1.9, "h": 1.1, "text": "Tree 3\nf₃(x)  …", "fill": "OI_GREEN", "color": "FFFFFF", "bold": true, "line": null },
    { "type": "text", "x": 9.0, "y": 3.2, "w": 2.3, "h": 0.35, "fontSize": 11, "color": "SUBTITLE_GRAY", "text": "fits residuals r₂" },

    { "type": "line", "x1": 0.6, "y1": 4.15, "x2": 10.8, "y2": 4.15, "dash": "dash", "color": "LINE_GRAY", "width": 0.75 },
    { "type": "text", "x": 0, "y": 4.35, "w": 11.4, "h": 0.5, "bold": true, "fontSize": 14,
      "text": "Final prediction:  F(x) = f₁(x) + η·f₂(x) + η·f₃(x) + …    (η = learning rate, shrinks each correction)" }
  ]
}
